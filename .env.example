# ===================================================
# TaskPulse Environment Template (.env.example)
# ===================================================

NEXT_PUBLIC_APP_NAME=TaskPulse
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
PORT=3000

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres

SHARE_CODE_LENGTH=6
DEFAULT_SHARE_EXPIRY_HOURS=24
NEXT_PUBLIC_ENABLE_P2P_REDIRECT=true

LOG_LEVEL=info
LOG_DIR=logs
TOKEN_USAGE_FILE=token_usage.md
VERSION_FILE=VERSION.md
ENHANCEMENTS_FILE=ENHANCEMENTS.md

LDAP_ENABLED=false
LDAP_URL=ldap://127.0.0.1:389
LDAP_BIND_DN=cn=admin,dc=company,dc=com
LDAP_BIND_PASSWORD=admin_password
LDAP_SEARCH_BASE=ou=users,dc=company,dc=com
