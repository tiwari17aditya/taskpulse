# ===================================================
# TaskPulse Environment Variable Template (.env.example)
# ===================================================

NEXT_PUBLIC_APP_NAME=TaskPulse
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
PORT=3000

# Options: 'supabase' | 'neondb' | 'postgres' | 'local'
NEXT_PUBLIC_DB_PROVIDER=supabase

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

NEON_DATABASE_URL=postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres

GITHUB_USERNAME=your-github-username
GITHUB_REPO_NAME=taskpulse
GITHUB_REPO_URL=https://github.com/your-username/taskpulse.git
GITHUB_BRANCH=main
GITHUB_ACCESS_TOKEN=ghp_your_github_personal_access_token_here

VERCEL_PROJECT_ID=prj_your_vercel_project_id_here
VERCEL_ORG_ID=team_your_vercel_org_id_here
VERCEL_TEAM_ID=team_your_vercel_team_id_here
VERCEL_TOKEN=your_vercel_api_access_token_here

SHARE_CODE_LENGTH=6
DEFAULT_SHARE_EXPIRY_HOURS=24
NEXT_PUBLIC_ENABLE_P2P_REDIRECT=true

LOG_LEVEL=info
LOG_DIR=logs
TOKEN_USAGE_FILE=token_usage.md
VERSION_FILE=VERSION.md
ENHANCEMENTS_FILE=ENHANCEMENTS.md

LDAP_ENABLED=false
LDAP_URL=ldap://127.0.0.1:389
LDAP_BIND_DN=cn=admin,dc=company,dc=com
LDAP_BIND_PASSWORD=admin_password
LDAP_SEARCH_BASE=ou=users,dc=company,dc=com
